{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "EDAYA_TEST_POOL_METRICS"
  ],
  "tasks": {
    "build": {
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "check": {
      "dependsOn": [
        "^check"
      ]
    },
    "quality": {
      "dependsOn": [
        "^check"
      ]
    },
    "test": {
      "cache": false
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.js",
        "$TURBO_ROOT$/tooling/repo/eslint-imports.js"
      ]
    },
    "lint:fix": {},
    "test:integration": {
      "cache": false
    }
  },
  "globalDependencies": [
    "package/adaptor-postgres/tests/support/**",
    "package/domain-service/tests/support/**",
    "tooling/test-support/**"
  ]
}
