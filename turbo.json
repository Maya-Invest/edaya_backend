{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "EDAYA_TEST_POOL_METRICS"
  ],
  "tasks": {
    "build": {
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "check": {
      "dependsOn": [
        "^check"
      ]
    },
    "quality": {
      "dependsOn": [
        "^check"
      ]
    },
    "test": {
      "dependsOn": [
        "^check"
      ]
    },
    "lint": {},
    "lint:fix": {}
  },
  "globalDependencies": [
    "package/adaptor-postgres/tests/support/**",
    "package/domain-service/tests/support/**",
    "tooling/test-support/**"
  ]
}
