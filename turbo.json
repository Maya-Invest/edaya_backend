{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**", "build/**"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "quality": {
      "dependsOn": ["^check"]
    },
    "test": {
      "dependsOn": ["^check"]
    },
    "lint": {},
    "lint:fix": {}
  }
}
