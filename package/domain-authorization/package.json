{
  "name": "@edaya/authorization",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "check": "bun x --bun tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "bun x --bun eslint src tests",
    "lint:fix": "bun x --bun eslint src tests --fix"
  },
  "dependencies": {
    "@edaya/core": "workspace:*",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
