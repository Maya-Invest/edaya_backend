{
  "name": "@maya-invest/edaya-identity-client",
  "type": "module",
  "version": "0.0.0",
  "description": "School-side identity JWT verify and directory client",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maya-Invest/edaya_backend.git",
    "directory": "package/identity-client"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "bun": "./src/testing.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "quality": "bun run lint && bun run check",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "bun test src"
  },
  "dependencies": {
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.2"
  }
}
