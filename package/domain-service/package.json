{
  "name": "@edaya/service",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "test": "bun test --timeout 30000",
    "test:coverage": "bun test --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "preview:timetable": "bun scripts/preview-timetable.ts"
  },
  "dependencies": {
    "@edaya/authorization": "workspace:*",
    "@edaya/core": "workspace:*",
    "cron-parser": "^5.6.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
