{
  "name": "@edaya/service",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "check": "bun x --bun tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "test": "bun test --timeout 30000 --path-ignore-patterns '**/*.integration.test.ts' --preload ../../tooling/test-support/unit-preload.ts",
    "test:coverage": "bun run test --coverage --coverage-reporter=lcov",
    "lint": "bun x --bun eslint src tests",
    "lint:fix": "bun x --bun eslint src tests --fix",
    "preview:timetable": "bun scripts/preview-timetable.ts",
    "benchmark:timetable": "bun scripts/benchmark-timetable.ts",
    "benchmark:timetable:solver": "bun scripts/benchmark-timetable-solver.ts",
    "benchmark:timetable:baseline": "bun scripts/prepare-timetable-baseline.ts",
    "test:integration": "NODE_ENV=test bun test .integration.test.ts --timeout 120000 --preload ../../tooling/test-support/preload.ts"
  },
  "dependencies": {
    "@edaya/authorization": "workspace:*",
    "@edaya/core": "workspace:*",
    "cron-parser": "^5.6.1",
    "file-type": "21.3.4",
    "pngjs": "7.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/pngjs": "6.0.5"
  }
}
