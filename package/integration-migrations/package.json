{
  "name": "@edaya/integration-migrations",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/auth/index.ts",
      "import": "./src/auth/index.ts"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "import": "./src/auth/index.ts"
    },
    "./auth/schema": {
      "types": "./src/auth/schema.ts",
      "import": "./src/auth/schema.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "auth:generate-schema": "bunx @better-auth/cli@1.6.16 generate --config ./src/auth/cli/auth-config.ts --output ./src/auth/schema.ts --yes",
    "auth:db:generate": "drizzle-kit generate --config drizzle.auth.config.ts",
    "auth:migrate:local": "bun ./scripts/auth-migrate.ts local",
    "auth:migrate:remote": "bun ./scripts/auth-migrate.ts remote",
    "auth:migrate:staging": "bun ./scripts/auth-migrate.ts remote staging",
    "auth:db:push": "drizzle-kit push --config drizzle.auth.config.ts",
    "school:migrate": "drizzle-kit migrate --config drizzle.school.config.ts",
    "school:migrate:all": "bun ./scripts/school-migrate-all.ts",
    "school:migrate:dev": "bun ./scripts/school-migrate-dev.ts",
    "school:migrate:staging": "bun ./scripts/school-migrate-staging.ts",
    "school:repair-journal": "bun ./scripts/repair-drizzle-journal.ts",
    "lint": "eslint src scripts drizzle.auth.config.ts drizzle.school.config.ts",
    "lint:fix": "eslint src scripts drizzle.auth.config.ts drizzle.school.config.ts --fix",
    "test": "bun test"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.0",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "better-auth": "^1.6.16",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^11.0.7",
    "drizzle-kit": "^0.30.4",
    "wrangler": "^4.99.0"
  }
}
