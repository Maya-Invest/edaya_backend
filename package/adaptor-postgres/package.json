{
  "name": "@edaya/adaptor-postgres",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "check": "bun x --bun tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "lint": "bun x --bun eslint src tests",
    "lint:fix": "bun x --bun eslint src tests --fix",
    "test": "bun test tests --timeout 30000"
  },
  "dependencies": {
    "@edaya/authorization": "workspace:*",
    "@edaya/core": "workspace:*",
    "@edaya/service": "workspace:*",
    "drizzle-orm": "^0.39.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.30.4"
  }
}
