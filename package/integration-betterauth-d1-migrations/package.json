{
  "name": "@edaya/betterauth-d1-migrations",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "auth:generate-schema": "bunx @better-auth/cli@1.6.16 generate --config ./src/cli/auth-config.ts --output ./src/schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "migrate:local": "bun ./scripts/migrate.ts local",
    "migrate:remote": "bun ./scripts/migrate.ts remote",
    "migrate:staging": "bun ./scripts/migrate.ts remote staging",
    "db:push": "drizzle-kit push",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "test": "bun test"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "better-auth": "^1.6.16",
    "drizzle-kit": "^0.30.4",
    "wrangler": "^4.99.0"
  }
}
