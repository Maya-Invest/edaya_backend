{
  "name": "@edaya/document-rendering",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "precompile": "bun scripts/precompile-templates.ts",
    "build": "bun run precompile && tsc --noEmit",
    "check": "bun run precompile && tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "bun run precompile && bun test src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.893.0",
    "@aws-sdk/s3-request-presigner": "3.893.0",
    "@edaya/document-contracts": "workspace:*",
    "ajv": "8.17.1",
    "exceljs": "4.4.0",
    "handlebars": "4.7.8",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/exceljs": "1.3.2",
    "@types/handlebars": "4.1.0"
  }
}
