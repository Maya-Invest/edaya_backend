{
  "name": "@edaya/core",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./domain/*": {
      "types": "./src/domain/*",
      "import": "./src/domain/*"
    },
    "./ports/*": {
      "types": "./src/ports/*",
      "import": "./src/ports/*"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix"
  },
  "dependencies": {
    "cron-parser": "^5.6.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
