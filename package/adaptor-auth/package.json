{
  "name": "@edaya/adaptor-auth",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts"
    },
    "./drizzle": {
      "types": "./src/drizzle.ts",
      "import": "./src/drizzle.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "auth:generate-schema": "bunx @better-auth/cli@1.6.16 generate --config ./src/cli/auth-config.ts --output ./src/schema.ts --yes",
    "auth:db:generate": "drizzle-kit generate --config drizzle.auth.config.ts",
    "auth:db:push": "drizzle-kit push --config drizzle.auth.config.ts",
    "lint": "eslint src drizzle.auth.config.ts",
    "lint:fix": "eslint src drizzle.auth.config.ts --fix",
    "test": "bun test"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@types/bun": "^1.3.14",
    "better-auth": "^1.6.16",
    "drizzle-kit": "^0.30.4"
  }
}
