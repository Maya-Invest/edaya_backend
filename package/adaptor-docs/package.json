{
  "name": "@edaya/adaptor-docs",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "precompile": "bun scripts/precompile-templates.ts",
    "check": "bun run precompile && tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint src tests scripts --fix",
    "test": "bun run precompile && bun test tests"
  },
  "dependencies": {
    "@edaya/core": "workspace:*",
    "ajv": "8.17.1",
    "handlebars": "4.7.8",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
