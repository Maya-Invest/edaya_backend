{
  "name": "@edaya/adaptor-import-format",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "check": "bun x --bun tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "test": "bun test --path-ignore-patterns '**/*.integration.test.ts' --preload ../../tooling/test-support/unit-preload.ts",
    "lint": "bun x --bun eslint src tests",
    "lint:fix": "bun x --bun eslint src tests --fix"
  },
  "dependencies": {
    "@edaya/core": "workspace:*",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
