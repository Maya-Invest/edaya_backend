{
  "name": "@edaya/adaptor-betterauth",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "auth:generate-schema": "bunx @better-auth/cli@latest generate --config ./src/cli/auth-config.ts --output ./src/schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun ./scripts/migrate-d1-local.ts",
    "db:migrate:local": "bun ./scripts/migrate-d1-local.ts",
    "db:migrate:remote": "bun ./scripts/migrate-d1-remote.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "bun test"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "better-auth": "^1.6.16",
    "drizzle-kit": "^0.30.4",
    "wrangler": "^4.99.0"
  }
}
