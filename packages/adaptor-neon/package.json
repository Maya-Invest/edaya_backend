{
  "name": "@edaya/adaptor-neon",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:all": "bun ./scripts/migrate-all.ts",
    "db:migrate:dev": "bun ./scripts/migrate-dev-database.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@edaya/core": "workspace:*",
    "drizzle-orm": "^0.39.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^11.0.7",
    "drizzle-kit": "^0.30.4"
  }
}
