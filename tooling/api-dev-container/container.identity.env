# Baked into the api-dev image — dev-only secrets, not for staging/production.
PORT=9900
AUTH_DATABASE_URL=pglite:/edaya_identity/.data/identity
BETTER_AUTH_URL=http://localhost:9900
FIRST_PARTY_API_ORIGINS=http://localhost:9999
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
WEBAPP_ORIGIN=http://localhost:5173
IDENTITY_DIRECTORY_SECRET=edaya-container-directory-secret
BETTER_AUTH_SECRET=edaya-container-identity-secret-not-for-production
REQUIRE_EMAIL_VERIFICATION=false
AUTH_EMAIL_LOG_OTP=true
EMAIL_FROM=EDAYA <noreply@edayaplus.com>
