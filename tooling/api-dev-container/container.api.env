# Baked into the api-dev image — dev-only secrets, not for staging/production.
RUNTIME=local
NODE_ENV=development
PORT=9999
LOG_LEVEL=error

DATABASE_URL=pglite:.data/school
RUN_MIGRATIONS_ON_STARTUP=true

SCHOOL_API_ORIGIN=http://localhost:9999
IDENTITY_ISSUER=http://localhost:9900
IDENTITY_DIRECTORY_URL=http://localhost:9900
IDENTITY_DIRECTORY_SECRET=edaya-container-directory-secret
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

LOCAL_FILES_URL=http://localhost:9200
LOCAL_FILES_ROOT=.data/files
LOCAL_FILES_PORT=9200
LOCAL_FILES_SECRET=edaya-container-files-secret

ALLOW_PUBLIC_SCHOOL_REGISTRATION=true
ACCOUNT_INVITATIONS_ENABLED=true
