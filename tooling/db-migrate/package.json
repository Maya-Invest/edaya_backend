{
  "name": "@edaya/db-migrate",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "migrate": "drizzle-kit migrate --config drizzle.school.config.ts",
    "migrate:local": "bun ./scripts/migrate-target.ts local full",
    "migrate:local:pg": "bun ./scripts/migrate-target.ts local pg",
    "migrate:local:auth": "bun ./scripts/migrate-target.ts local auth",
    "migrate:staging": "bun ./scripts/migrate-target.ts staging full",
    "migrate:staging:pg": "bun ./scripts/migrate-target.ts staging pg",
    "migrate:staging:auth": "bun ./scripts/migrate-target.ts staging auth",
    "migrate:production": "bun ./scripts/migrate-target.ts production full",
    "migrate:production:pg": "bun ./scripts/migrate-target.ts production pg",
    "migrate:production:auth": "bun ./scripts/migrate-target.ts production auth",
    "repair-journal": "bun ./scripts/repair-drizzle-journal.ts",
    "lint": "eslint scripts drizzle.school.config.ts",
    "lint:fix": "eslint scripts drizzle.school.config.ts --fix",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@edaya/adaptor-auth": "workspace:*",
    "@edaya/adaptor-postgres": "workspace:*",
    "@edaya/core": "workspace:*",
    "@electric-sql/pglite": "^0.3.14",
    "drizzle-orm": "^0.39.0",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^11.0.7",
    "drizzle-kit": "^0.30.4"
  }
}
