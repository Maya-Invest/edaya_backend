{
  "name": "@edaya/integration-tests",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "test": "bun test src/auth src/routes src/services src/runtime src/adaptor src/seed/contract.test.ts --parallel=1",
    "test:seeds": "bun test src/seed/slow --parallel=1",
    "test:invitation-link": "bun test src/routes/test-account-invitation-link.integration.test.ts --parallel=1",
    "test:full": "bun test --parallel=1",
    "smoke:staging": "bun ./scripts/smoke-staging.ts",
    "novu:smoke": "bun smoke/novu-e2e.ts",
    "generate:client": "edaya-codegen generate --input ${OPENAPI_INPUT:-../../tooling/repo/fixtures/openapi.json} --client-dir src/generated/api-client",
    "lint": "eslint src smoke",
    "lint:fix": "eslint src smoke --fix"
  },
  "devDependencies": {
    "@edaya/adaptor-novu": "workspace:*",
    "@edaya/adaptor-postgres": "workspace:*",
    "@edaya/api": "workspace:*",
    "@edaya/adaptor-auth": "workspace:*",
    "@edaya/core": "workspace:*",
    "@edaya/fixtures": "workspace:*",
    "@edaya/seeding": "workspace:*",
    "@edaya/client-codegen": "file:../../../edaya-client-codegen",
    "@electric-sql/pglite": "^0.4.6",
    "@types/bun": "^1.3.14",
    "better-auth": "^1.6.16",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^11.0.7",
    "drizzle-orm": "^0.39.0",
    "hono": "^4.7.9",
    "zod": "^3.24.4"
  }
}
