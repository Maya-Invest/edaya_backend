{
  "openapi": "3.0.0",
  "info": {
    "title": "Edaya Docs API",
    "version": "0.1.0",
    "description": "Stateless document rendering service for school platforms."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Service token (dev static bearer or HS256 JWT)"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "TemplateCatalogEntry": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "formats": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "pdf",
                "xlsx"
              ]
            }
          },
          "locales": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "formats",
          "locales",
          "version"
        ]
      },
      "TemplateCatalogResponse": {
        "type": "object",
        "properties": {
          "templates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateCatalogEntry"
            }
          }
        },
        "required": [
          "templates"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "RenderArtifact": {
        "type": "object",
        "properties": {
          "objectId": {
            "type": "string"
          },
          "downloadUrl": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "required": [
          "objectId",
          "downloadUrl",
          "expiresAt"
        ]
      },
      "RenderDocumentResponse": {
        "type": "object",
        "properties": {
          "renderId": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "bytesBase64": {
            "type": "string"
          },
          "artifact": {
            "$ref": "#/components/schemas/RenderArtifact"
          }
        },
        "required": [
          "renderId",
          "contentType",
          "sha256"
        ]
      },
      "SignaturePosition": {
        "type": "object",
        "properties": {
          "page": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "first"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "last"
                ]
              },
              {
                "type": "integer"
              }
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number"
          }
        },
        "required": [
          "page",
          "x",
          "y",
          "width"
        ]
      },
      "SignatureSlot": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string"
          },
          "position": {
            "$ref": "#/components/schemas/SignaturePosition"
          }
        },
        "required": [
          "slot",
          "imageUrl",
          "position"
        ]
      },
      "RenderOptions": {
        "type": "object",
        "properties": {
          "paper": {
            "type": "string",
            "enum": [
              "A4",
              "Letter"
            ]
          },
          "orientation": {
            "type": "string",
            "enum": [
              "portrait",
              "landscape"
            ]
          },
          "signatures": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SignatureSlot"
            }
          }
        }
      },
      "RenderDocumentRequest": {
        "type": "object",
        "properties": {
          "templateKey": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "enum": [
              "pdf",
              "xlsx"
            ]
          },
          "locale": {
            "type": "string",
            "minLength": 1
          },
          "schoolId": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "nullable": true
          },
          "options": {
            "$ref": "#/components/schemas/RenderOptions"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "inline",
              "storage"
            ]
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "templateKey",
          "format",
          "locale",
          "schoolId",
          "delivery",
          "idempotencyKey"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/templates": {
      "get": {
        "tags": [
          "Templates"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Templates visible to the caller token allowlist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateCatalogResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing service token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/render": {
      "post": {
        "tags": [
          "Render"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderDocumentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Render completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenderDocumentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing service token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Template or format not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Template not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Renderer unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  }
}
