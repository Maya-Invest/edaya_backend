{
  "name": "@edaya/repo",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "quality": "bun run lint",
    "test": "bun test tests --dots",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "doctor": "bun ci/doctor.ts",
    "check:boundaries": "bun ci/check-boundaries.ts",
    "export-openapi": "bun openapi/export.ts",
    "openapi:generate": "bun openapi/update.ts",
    "generated:update": "bun run openapi:generate",
    "generated:check": "bun openapi/check-drift.ts",
    "openapi:check": "bun run generated:check",
    "test:r2": "bun dev/r2-check-credentials.ts",
    "configure:r2-cors": "bun dev/r2-configure-cors.ts",
    "db:browser:school": "bun --env-file=../../apps/api/.env dev/db-browser.ts school",
    "db:browser:auth": "bun --env-file=../../apps/api/.env dev/db-browser.ts auth"
  },
  "dependencies": {
    "@edaya/adaptor-r2": "workspace:*",
    "@edaya/client-codegen": "https://github.com/Maya-Invest/edaya-client-codegen",
    "@electric-sql/pglite": "^0.4.6",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^11.0.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.2"
  }
}
