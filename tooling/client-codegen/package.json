{
  "name": "@edaya/client-codegen",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract/index.ts",
      "import": "./src/contract/index.ts"
    }
  },
  "bin": {
    "edaya-codegen": "./bin/edaya-codegen.ts"
  },
  "scripts": {
    "test": "bun test tests --dots",
    "check": "tsc --noEmit",
    "lint": "eslint src tests bin",
    "lint:fix": "eslint src tests bin --fix",
    "quality": "bun run lint && bun run check"
  },
  "dependencies": {
    "openapi-typescript": "^7.13.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.2"
  }
}
