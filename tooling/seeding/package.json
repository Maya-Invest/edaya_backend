{
  "name": "@edaya/seeding",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./http": {
      "types": "./src/http/index.ts",
      "import": "./src/http/index.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "test": "bun test src --dots",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "seed:init": "bun scripts/seed-http.ts all",
    "seed:all": "bun run seed:init",
    "seed:auth": "bun scripts/seed-http.ts auth",
    "seed:auth:link": "bun scripts/seed-http.ts auth:link",
    "seed:smoke": "bun scripts/seed-http.ts smoke",
    "seed:validate": "bun scripts/seed-http.ts validate",
    "seed:clean": "bun scripts/cleanup-seed-data.ts --local",
    "seed:clean:staging": "bun scripts/cleanup-seed-data.ts --staging",
    "seed:remote": "bun scripts/seed-remote.ts",
    "seed:smoke:staging": "bun scripts/seed-smoke-staging.ts",
    "generate:client": "edaya-codegen generate --input ${OPENAPI_INPUT:-../../tooling/repo/fixtures/openapi.json} --client-dir src/generated/api-client"
  },
  "dependencies": {
    "@edaya/core": "workspace:*",
    "@edaya/fixtures": "workspace:*",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^11.0.7",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@edaya/client-codegen": "https://github.com/Maya-Invest/edaya-client-codegen",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.2"
  }
}
