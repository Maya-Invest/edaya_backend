{
  "name": "@edaya/seeding",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./http": {
      "types": "./src/http/index.ts",
      "import": "./src/http/index.ts"
    },
    "./transport/http": {
      "types": "./src/transport/http/index.ts",
      "import": "./src/transport/http/index.ts"
    },
    "./diagnostics": {
      "types": "./src/diagnostics/index.ts",
      "import": "./src/diagnostics/index.ts"
    },
    "./bootstrap": {
      "types": "./src/bootstrap/index.ts",
      "import": "./src/bootstrap/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "import": "./src/runtime/index.ts"
    },
    "./cli": {
      "types": "./src/support/cli.ts",
      "import": "./src/support/cli.ts"
    }
  },
  "scripts": {
    "check": "bun x --bun tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "test": "bun test src tests --dots --path-ignore-patterns '**/*.integration.test.ts' --preload ../../tooling/test-support/unit-preload.ts",
    "lint": "bun x --bun eslint src scripts",
    "lint:fix": "bun x --bun eslint src scripts --fix"
  },
  "dependencies": {
    "@edaya/authorization": "workspace:*",
    "@edaya/core": "workspace:*",
    "@edaya/service": "workspace:*",
    "@edaya/fixtures": "workspace:*",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^11.0.7",
    "postgres": "^3.4.4",
    "@maya-invest/edaya-api-client": "workspace:*"
  }
}
