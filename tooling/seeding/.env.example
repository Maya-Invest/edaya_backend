# -----------------------------------------------------------------------------
# Edaya seeding CLI — copy to `.env` (gitignored)
# `apps/api/.env` is also loaded as a fallback for BETTER_AUTH_URL.
# -----------------------------------------------------------------------------

# Target API (defaults to BETTER_AUTH_URL from apps/api/.env)
# SEED_API_URL=http://localhost:9999

# Override school profile (defaults to @edaya/fixtures central school)
# SEED_SCHOOL_ID=

# Narrative "today" for rolling dashboard seed data (attendance, events, fee due dates).
# Defaults to SEED_REFERENCE_DATE in @edaya/fixtures (2026-06-16).
# SEED_REFERENCE_DATE=2026-06-16
