{
  "name": "@edaya/solution",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "package/*",
    "tooling/*"
  ],
  "scripts": {
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "repo": "bun tooling/repo/cli/main.ts",
    "build": "turbo run build",
    "quality": "turbo run quality",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage --coverage-reporter=lcov",
    "test:integration": "bun --filter @edaya/integration-tests test:integration",
    "test:integration:api": "bun --filter @edaya/integration-tests test:integration:api",
    "test:integration:http": "bun --filter @edaya/integration-tests test:integration:http",
    "test:integration:seed": "bun --filter @edaya/integration-tests test:integration:seed",
    "test:docs:contract": "bun test tests/docs/contract",
    "test:docs:integration": "bun test tests/docs/integration",
    "docs:dev": "bun --filter @edaya/docs-api run dev",
    "docs:contracts:check": "bun tooling/docs/contracts/check.ts",
    "docs:openapi:check": "bun tooling/docs/openapi/check-drift.ts",
    "docs:openapi:export": "bun tooling/docs/openapi/export.ts",
    "docs:openapi:generate": "bun tooling/docs/openapi/generate.ts",
    "gotenberg:up": "podman compose -f tooling/docs/docker-compose.yml up -d gotenberg",
    "gotenberg:down": "podman compose -f tooling/docs/docker-compose.yml down",
    "preview:report-card": "bun scripts/docs/preview-report-card.ts",
    "preview:logbook": "bun scripts/docs/preview-logbook.ts",
    "verify": "bun repo verify && turbo run quality && turbo run build && turbo run test -- --dots && bun run test:docs:contract && bun run docs:contracts:check && bun run docs:openapi:check",
    "dev": "bun tooling/repo/dev/start-local-dev.ts",
    "dev:container": "bash tooling/api-dev-container/run.sh",
    "dev:container:down": "bash tooling/api-dev-container/run.sh down",
    "dev:container:logs": "bash tooling/api-dev-container/run.sh logs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^25.9.2",
    "eslint": "^9.39.0",
    "eslint-plugin-format": "^0.1.2",
    "tsup": "^8.5.1",
    "turbo": "^2.9.17",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "@maya-invest/edaya-api-client": "workspace:*",
    "@maya-invest/edaya-docs-client": "workspace:*"
  }
}
