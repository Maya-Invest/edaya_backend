{
  "name": "maya_school_core",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.2.13",
  "workspaces": [
    "apps/*",
    "packages/*",
    "testing/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "seed": "turbo run seed",
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "lint": "bunx turbo run lint",
    "lint:fix": "bunx turbo run lint:fix",
    "fullcheck": "bun lint:fix && bun check && bun run build && bun test --dots",
    "db:generate": "bun --filter @edaya/adaptor-postgres db:generate",
    "db:migrate": "bun --filter @edaya/adaptor-postgres db:migrate",
    "db:generate:auth": "bun --filter @edaya/adaptor-betterauth db:generate",
    "db:migrate:auth": "bun --filter @edaya/adaptor-betterauth db:migrate",
    "auth:generate-schema": "bun --filter @edaya/adaptor-betterauth auth:generate-schema",
    "openapi:generate": "bun run --cwd apps/api export-openapi && bun run --cwd apps/webapp openapi:generate && bun run --cwd apps/api generate-api-client"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^25.9.1",
    "eslint": "^9.39.0",
    "eslint-plugin-svelte": "^3.19.0",
    "svelte-eslint-parser": "^1.8.0",
    "tsup": "^8.5.1",
    "turbo": "^2.9.17",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  },
  "overrides": {
    "svelte": "5.56.3"
  }
}
