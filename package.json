{
  "name": "@edaya/solution",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "package/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@edaya/api",
    "dev:worker": "bun --filter @edaya/api dev:worker",
    "dev:cron": "bun --filter @edaya/cron dev",
    "dev:cron:worker": "bun --filter @edaya/cron dev:worker",
    "seed": "bun --filter @edaya/seeding seed:all",
    "seed:auth": "bun --filter @edaya/seeding seed:auth",
    "seed:auth:link": "bun --filter @edaya/seeding seed:auth:link",
    "seed:smoke": "bun --filter @edaya/seeding seed:smoke",
    "seed:validate": "bun --filter @edaya/seeding seed:validate",
    "seed:init": "bun --filter @edaya/seeding seed:init",
    "seed:clean": "bun --filter @edaya/seeding seed:clean",
    "seed:clean:staging": "bun --filter @edaya/seeding seed:clean:staging",
    "seed:remote": "bun --filter @edaya/seeding seed:remote",
    "seed:smoke:staging": "bun --filter @edaya/seeding seed:smoke:staging",
    "build": "turbo run build",
    "check": "turbo run check",
    "quality": "turbo run quality",
    "test:repo": "bun --filter @edaya/repo test",
    "test": "bun run test:repo && turbo run test",
    "test:integration-seeds": "bun --filter @edaya/integration-tests test:seeds",
    "test:coverage": "turbo run test -- --coverage",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "fix": "bun run lint:fix",
    "doctor": "bun --filter @edaya/repo doctor",
    "novu:smoke": "bun --filter @edaya/integration-tests novu:smoke",
    "novu:bootstrap": "bun --filter @edaya/novu-ops bootstrap",
    "novu:bootstrap:apply": "bun --filter @edaya/novu-ops bootstrap:apply",
    "novu:bootstrap:validate": "bun --filter @edaya/novu-ops bootstrap:validate",
    "novu:cleanup": "bun --filter @edaya/novu-ops cleanup",
    "novu:cleanup:apply": "bun --filter @edaya/novu-ops cleanup:apply",
    "verify": "bun run doctor && bun run lint && bun run check && bun run build && bun run generated:check && bun run check:boundaries && bun run test:repo && turbo run test -- --dots",
    "fullcheck": "bun run verify",
    "deploy:api": "bun --filter @edaya/api deploy:worker",
    "deploy:api:staging": "bun --filter @edaya/api deploy:worker:staging",
    "deploy:cron": "bun --filter @edaya/cron deploy:worker",
    "deploy:cron:staging": "bun --filter @edaya/cron deploy:worker:staging",
    "smoke:staging": "bun --filter @edaya/integration-tests smoke:staging",
    "db:generate": "bun --filter @edaya/adaptor-postgres db:generate",
    "db:migrate": "bun --filter @edaya/db-migrate school:migrate",
    "db:migrate:all": "bun --filter @edaya/db-migrate school:migrate:all",
    "db:migrate:dev": "bun --filter @edaya/db-migrate school:migrate:dev",
    "db:migrate:staging": "bun --filter @edaya/db-migrate school:migrate:staging",
    "db:generate:auth": "bun --filter @edaya/adaptor-auth auth:db:generate",
    "db:migrate:auth": "bun --filter @edaya/db-migrate auth:migrate:local",
    "db:migrate:auth:remote": "bun --filter @edaya/db-migrate auth:migrate:remote",
    "db:migrate:auth:staging": "bun --filter @edaya/db-migrate auth:migrate:staging",
    "db:browser:school": "bun --filter @edaya/repo db:browser:school",
    "db:browser:auth": "bun --filter @edaya/repo db:browser:auth",
    "auth:generate-schema": "bun --filter @edaya/adaptor-auth auth:generate-schema",
    "export-openapi": "bun --filter @edaya/repo export-openapi",
    "test:r2": "bun --filter @edaya/repo test:r2",
    "configure:r2-cors": "bun --filter @edaya/repo configure:r2-cors",
    "openapi:generate": "bun --filter @edaya/repo openapi:generate",
    "generated:update": "bun --filter @edaya/repo generated:update",
    "generated:check": "bun --filter @edaya/repo generated:check",
    "openapi:check": "bun --filter @edaya/repo openapi:check",
    "check:boundaries": "bun --filter @edaya/repo check:boundaries"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^25.9.2",
    "eslint": "^9.39.0",
    "eslint-plugin-format": "^0.1.2",
    "tsup": "^8.5.1",
    "turbo": "^2.9.17",
    "typescript": "^6.0.2"
  }
}
