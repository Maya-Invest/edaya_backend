{
  "name": "@edaya/solution",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*",
    "testing/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:worker": "bun --filter @edaya/api dev:worker",
    "seed": "bun --filter @edaya/seeding seed:all",
    "seed:auth": "bun --filter @edaya/seeding seed:auth",
    "seed:smoke": "bun --filter @edaya/seeding seed:smoke",
    "seed:init": "bun --filter @edaya/seeding seed:init",
    "seed:remote": "bun --filter @edaya/seeding seed:remote",
    "build": "turbo run build",
    "check": "turbo run check",
    "quality": "turbo run quality",
    "test": "turbo run test",
    "test:remote": "bun --filter @edaya/integration-tests test:remote",
    "test:coverage": "turbo run test -- --coverage",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "fullcheck": "bun run lint:fix && bun run check && bun run build && bun run check:boundaries && turbo run test -- --dots",
    "deploy:api": "bun --filter @edaya/api deploy:worker",
    "deploy:webapp": "bun --filter @edaya/webapp deploy",
    "db:generate": "bun --filter @edaya/adaptor-postgres db:generate",
    "db:migrate": "bun --filter @edaya/neon-migrations migrate",
    "db:migrate:all": "bun --filter @edaya/neon-migrations migrate:all",
    "db:migrate:dev": "bun --filter @edaya/neon-migrations migrate:dev",
    "db:generate:auth": "bun --filter @edaya/betterauth-d1-migrations db:generate",
    "db:migrate:auth": "bun --filter @edaya/betterauth-d1-migrations migrate:local",
    "db:migrate:auth:remote": "bun --filter @edaya/betterauth-d1-migrations migrate:remote",
    "auth:generate-schema": "bun --filter @edaya/betterauth-d1-migrations auth:generate-schema",
    "openapi:generate": "bun run --cwd apps/api export-openapi && bun run --cwd apps/webapp openapi:generate && bun run --cwd apps/api generate-api-client",
    "openapi:check": "bun run openapi:generate && bun scripts/check-openapi-drift.ts",
    "check:boundaries": "bash scripts/check-import-boundaries.sh"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^25.9.2",
    "eslint": "^9.39.0",
    "eslint-plugin-svelte": "^3.19.0",
    "svelte-eslint-parser": "^1.8.0",
    "tsup": "^8.5.1",
    "turbo": "^2.9.17",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "svelte": "5.56.3"
  }
}
