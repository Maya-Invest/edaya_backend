{
  "name": "@edaya/solution",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "package/*",
    "tooling/*"
  ],
  "scripts": {
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "repo": "bun tooling/repo/cli/main.ts",
    "build": "turbo run build",
    "quality": "turbo run quality",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage --coverage-reporter=lcov",
    "test:integration": "bun --filter @edaya/integration-tests test:integration",
    "test:integration:api": "bun --filter @edaya/integration-tests test:integration:api",
    "test:integration:http": "bun --filter @edaya/integration-tests test:integration:http",
    "test:integration:seed": "bun --filter @edaya/integration-tests test:integration:seed",
    "test:integration:native": "bun --filter @edaya/integration-tests test:integration:native",
    "verify": "python3 -m unittest discover -s .github/scripts -p 'test_*.py' && bun repo verify && bun test ./.github/scripts/*.test.mjs && turbo run quality && turbo run build && turbo run test --concurrency=2 -- --dots",
    "dev": "bun tooling/repo/dev/start-local-dev.ts",
    "dev:container": "bash tooling/api-dev-container/run.sh",
    "dev:container:down": "bash tooling/api-dev-container/run.sh down",
    "dev:container:logs": "bash tooling/api-dev-container/run.sh logs",
    "dev:test": "bun --filter @edaya/api dev:test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^25.9.2",
    "eslint": "^9.39.0",
    "eslint-plugin-format": "^0.1.2",
    "turbo": "^2.9.17",
    "typescript": "^6.0.2",
    "@types/bun": "^1.3.14"
  },
  "overrides": {
    "@maya-invest/edaya-api-client": "workspace:*"
  }
}
