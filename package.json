{
  "name": "@edaya/solution",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "package/*",
    "tooling/*"
  ],
  "scripts": {
    "prepare": "bun --no-env-file tooling/repo/ops/hooks.ts",
    "repo": "bun --no-env-file tooling/repo/ops/main.ts",
    "build": "bun x --bun turbo run build",
    "quality": "bun x --bun turbo run quality",
    "check": "bun x --bun turbo run check",
    "lint": "bun x --bun turbo run lint",
    "lint:fix": "bun x --bun turbo run lint:fix",
    "test": "bun x --bun turbo run test --concurrency=1",
    "test:coverage": "bun x --bun turbo run test -- --coverage --coverage-reporter=lcov",
    "test:integration": "bun --filter @edaya/integration-tests test:integration",
    "test:integration:api": "bun --filter @edaya/integration-tests test:integration:api",
    "test:integration:http": "bun --filter @edaya/integration-tests test:integration:http",
    "test:integration:seed": "bun --filter @edaya/integration-tests test:integration:seed",
    "test:integration:native": "bun --filter @edaya/integration-tests test:integration:native",
    "verify": "bun run repo ci verify",
    "dev": "bun --no-env-file tooling/repo/dev/start-local-dev.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2",
    "eslint": "^9.39.0",
    "eslint-plugin-format": "^0.1.2",
    "turbo": "^2.9.17",
    "typescript": "^6.0.2",
    "wrangler": "^4.153.0"
  },
  "overrides": {
    "@maya-invest/edaya-api-client": "workspace:*"
  }
}
