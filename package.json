{
  "name": "@edaya/solution",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "package/*",
    "testing/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@edaya/api --filter=@edaya/webapp",
    "dev:worker": "bun --filter @edaya/api dev:worker",
    "dev:cron": "bun --filter @edaya/cron dev",
    "dev:cron:worker": "bun --filter @edaya/cron dev:worker",
    "seed": "bun --filter @edaya/seeding seed:all",
    "seed:auth": "bun --filter @edaya/seeding seed:auth",
    "seed:auth:link": "bun --filter @edaya/seeding seed:auth:link",
    "seed:smoke": "bun --filter @edaya/seeding seed:smoke",
    "seed:validate": "bun --filter @edaya/seeding seed:validate",
    "seed:init": "bun --filter @edaya/seeding seed:init",
    "seed:clean": "bun --filter @edaya/seeding seed:clean",
    "seed:clean:staging": "bun --filter @edaya/seeding seed:clean:staging",
    "seed:remote": "bun --filter @edaya/seeding seed:remote",
    "seed:smoke:staging": "bun --filter @edaya/seeding seed:smoke:staging",
    "build": "turbo run build",
    "check": "turbo run check",
    "quality": "turbo run quality",
    "test:repo": "bun test ./scripts/check-import-boundaries.ts ./scripts/generated-artifacts.ts ./scripts/client-bindings-openapi.test.ts --dots",
    "test": "bun run test:repo && turbo run test",
    "test:integration-seeds": "bun --filter @edaya/integration-tests test:seeds",
    "test:coverage": "turbo run test -- --coverage",
    "lint": "eslint scripts && turbo run lint",
    "lint:fix": "eslint scripts --fix && turbo run lint:fix",
    "fix": "bun run lint:fix",
    "doctor": "bun scripts/doctor.ts",
    "novu:smoke": "bun scripts/novu-e2e-smoke.ts",
    "novu:bootstrap": "bun package/adaptor-novu/bootstrap/cli.ts plan",
    "novu:bootstrap:apply": "bun package/adaptor-novu/bootstrap/cli.ts apply",
    "novu:bootstrap:validate": "bun package/adaptor-novu/bootstrap/cli.ts validate",
    "novu:cleanup": "bun package/adaptor-novu/cleanup/cli.ts plan",
    "novu:cleanup:apply": "bun package/adaptor-novu/cleanup/cli.ts apply",
    "verify": "bun run doctor && bun run lint && bun run check && bun run build && bun run generated:check && bun run check:boundaries && bun run test:repo && turbo run test -- --dots",
    "fullcheck": "bun run verify",
    "deploy:api": "bun --filter @edaya/api deploy:worker",
    "deploy:api:staging": "bun --filter @edaya/api deploy:worker:staging",
    "deploy:cron": "bun --filter @edaya/cron deploy:worker",
    "deploy:cron:staging": "bun --filter @edaya/cron deploy:worker:staging",
    "deploy:webapp": "bun --filter @edaya/webapp deploy",
    "deploy:webapp:staging": "bun --filter @edaya/webapp deploy:staging",
    "smoke:staging": "bun --filter @edaya/integration-tests smoke:staging",
    "db:generate": "bun --filter @edaya/adaptor-postgres db:generate",
    "db:migrate": "bun --filter @edaya/neon-migrations migrate",
    "db:migrate:all": "bun --filter @edaya/neon-migrations migrate:all",
    "db:migrate:dev": "bun --filter @edaya/neon-migrations migrate:dev",
    "db:migrate:staging": "bun --filter @edaya/neon-migrations migrate:staging",
    "db:generate:auth": "bun --filter @edaya/betterauth-d1-migrations db:generate",
    "db:migrate:auth": "bun --filter @edaya/betterauth-d1-migrations migrate:local",
    "db:migrate:auth:remote": "bun --filter @edaya/betterauth-d1-migrations migrate:remote",
    "db:migrate:auth:staging": "bun --filter @edaya/betterauth-d1-migrations migrate:staging",
    "db:browser:school": "bun --env-file=apps/api/.env scripts/db-browser.ts school",
    "db:browser:auth": "bun --env-file=apps/api/.env scripts/db-browser.ts auth",
    "auth:generate-schema": "bun --filter @edaya/betterauth-d1-migrations auth:generate-schema",
    "openapi:generate": "bun run --cwd apps/api export-openapi && bun run --cwd apps/webapp openapi:generate && bun scripts/generate-client-bindings.ts",
    "generated:update": "bun run openapi:generate",
    "generated:check": "bun scripts/check-openapi-drift.ts",
    "openapi:check": "bun run generated:check",
    "check:boundaries": "bun scripts/check-import-boundaries.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@edaya/adaptor-novu": "workspace:*",
    "@electric-sql/pglite": "^0.4.6",
    "@types/node": "^25.9.2",
    "eslint": "^9.39.0",
    "eslint-plugin-svelte": "^3.19.0",
    "svelte-eslint-parser": "^1.8.0",
    "tsup": "^8.5.1",
    "turbo": "^2.9.17",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "svelte": "5.56.3"
  }
}
