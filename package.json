{
  "name": "@edaya/solution",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "package/*",
    "tooling/*"
  ],
  "scripts": {
    "repo": "bun tooling/repo/cli/main.ts",
    "dev": "bun tooling/repo/dev/start-local-dev.ts",
    "dev:worker": "bun --filter @edaya/api dev:worker",
    "cron:local": "bun --filter @edaya/api cron:local",
    "seed": "bun tooling/seeding/scripts/seed.ts",
    "seed:staging": "bun tooling/seeding/scripts/seed.ts --staging",
    "seed:doctor": "bun tooling/seeding/scripts/seed.ts --scope doctor",
    "seed:clean": "bun tooling/seeding/scripts/seed.ts clean",
    "seed:clean:staging": "bun tooling/seeding/scripts/seed.ts clean --staging",
    "build": "turbo run build",
    "check": "turbo run check",
    "quality": "turbo run quality",
    "test:repo": "bun --filter @edaya/repo test",
    "test": "bun run test:repo && turbo run test",
    "test:integration": "bun --filter @edaya/integration-tests test && bun run test:integration-seeds",
    "test:integration-seeds": "bun --filter @edaya/integration-tests test:slow",
    "test:coverage": "turbo run test -- --coverage",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "fix": "bun run lint:fix",
    "doctor": "bun repo doctor",
    "novu:smoke": "bun repo smoke-test novu",
    "novu:bootstrap": "bun repo novu bootstrap",
    "novu:bootstrap:apply": "bun repo novu bootstrap apply",
    "novu:bootstrap:validate": "bun repo novu bootstrap validate",
    "novu:cleanup": "bun repo novu cleanup",
    "novu:cleanup:apply": "bun repo novu cleanup apply",
    "verify": "bun repo verify",
    "api-dev-container": "bash tooling/api-dev-container/run.sh",
    "deploy:api:production": "bun repo deploy api production",
    "deploy:api:staging": "bun repo deploy api staging",
    "smoke:staging": "bun repo smoke-test staging",
    "db:generate": "bun repo db generate",
    "db:migrate:local": "bun repo db migrate local",
    "db:migrate:local:school": "bun repo db migrate local --school",
    "db:migrate:local:auth": "bun repo db migrate local --auth",
    "db:migrate:staging": "bun repo db migrate staging",
    "db:migrate:staging:school": "bun repo db migrate staging --school",
    "db:migrate:staging:auth": "bun repo db migrate staging --auth",
    "db:migrate:production": "bun repo db migrate production",
    "db:migrate:production:school": "bun repo db migrate production --school",
    "db:migrate:production:auth": "bun repo db migrate production --auth",
    "db:generate:auth": "bun repo db generate --auth",
    "db:browser:school": "bun repo db browser school",
    "db:browser:auth": "bun repo db browser auth",
    "auth:generate-schema": "bun --filter @edaya/adaptor-auth auth:generate-schema",
    "export-openapi": "bun repo openapi export",
    "test:r2": "bun repo smoke-test r2",
    "configure:r2-cors": "bun tooling/repo/dev/r2-configure-cors.ts",
    "openapi:generate": "bun repo openapi generate",
    "openapi:check": "bun repo check openapi",
    "generated:update": "bun repo openapi generate",
    "generated:check": "bun repo check openapi",
    "check:boundaries": "bun repo check boundaries",
    "check:test-naming": "bun repo check test-naming"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^25.9.2",
    "eslint": "^9.39.0",
    "eslint-plugin-format": "^0.1.2",
    "tsup": "^8.5.1",
    "turbo": "^2.9.17",
    "typescript": "^6.0.2"
  }
}
