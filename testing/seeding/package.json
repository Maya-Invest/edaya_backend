{
  "name": "@edaya/seeding",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./http": {
      "types": "./src/http/index.ts",
      "import": "./src/http/index.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "seed:all": "bun scripts/seed-http.ts all",
    "seed:auth": "bun scripts/seed-http.ts auth",
    "seed:smoke": "bun scripts/seed-http.ts smoke",
    "seed:init": "bun scripts/seed-init.ts",
    "seed:remote": "bun scripts/seed-remote.ts"
  },
  "dependencies": {
    "@edaya/core": "workspace:*",
    "@edaya/dev-fixtures": "workspace:*",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^11.0.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.2"
  }
}
