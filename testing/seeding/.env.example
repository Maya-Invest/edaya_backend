# Copy to .env (gitignored). `apps/api/.env` is also loaded as a fallback.

# Target API (defaults to BETTER_AUTH_URL from apps/api/.env)
# SEED_API_URL=http://localhost:9999

# Service account API key for /core/* HTTP seeding (optional override).
# When unset, seeding uses the `seedingApiKey` from the school profile in @edaya/dev-fixtures.
# SERVICE_ACCOUNT_API_KEY=sk_live_...

# Narrative "today" for rolling dashboard seed data (attendance, upcoming events, fee due dates).
# Defaults to SEED_REFERENCE_DATE in @edaya/dev-fixtures (2026-06-16).
# SEED_REFERENCE_DATE=2026-06-16
