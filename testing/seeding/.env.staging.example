# Staging URLs only — copy to `testing/seeding/.env.staging` (gitignored).
# Secrets belong in Wrangler (`BETTER_AUTH_SECRET`), not here.

STAGING_API_URL=https://api-staging.edaya.softilab.dev
STAGING_APP_ORIGIN=https://app-staging.edaya.softilab.dev
SEED_API_URL=https://api-staging.edaya.softilab.dev

# Neon staging branch connection string — used by `bun run db:migrate:staging` only.
# STAGING_DATABASE_URL=postgres://…

# Optional overrides for smoke sign-in (defaults to dev fixture director account).
# SMOKE_STAFF_EMAIL=c.moreau@school.edu
# SMOKE_STAFF_PASSWORD=…

# Smoke check S7 uses the `seedingApiKey` from the school profile in @edaya/dev-fixtures.
