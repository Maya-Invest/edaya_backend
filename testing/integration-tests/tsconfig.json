{
  "extends": "../../apps/api/tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": ["../../apps/api/src/*"],
      "@/runtime/resolve-api-runtime": ["../../apps/api/src/runtime/local/resolve-api-runtime.ts"],
      "@api-tests/*": ["../../apps/api/tests/*"]
    }
  },
  "include": [
    "src/**/*",
    "../../apps/api/src/**/*",
    "../../apps/api/tests/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
