{
  "name": "@edaya/novu-email-bridge",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --env-file .dev.vars",
    "check": "tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "bun test ./tests --dots",
    "deploy:worker": "wrangler deploy --env production",
    "deploy:worker:staging": "wrangler deploy --env staging"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260610.0",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.2",
    "wrangler": "^4.99.0"
  }
}
