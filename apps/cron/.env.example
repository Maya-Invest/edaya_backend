# -----------------------------------------------------------------------------
# Edaya Cron — local process runtime
# Copy to `.env` (gitignored).
# -----------------------------------------------------------------------------

RUNTIME=local
NODE_ENV=development
LOG_LEVEL=info

# PGlite persisted under repo-root `.data/` (RUNTIME=local only).
DATABASE_URL=pglite:.data/school
RUN_MIGRATIONS_ON_STARTUP=true

# --- Novu (notification dispatch + delivery reconciliation) ---
# NOVU_SECRET_KEY=
# NOVU_API_URL=https://eu.api.novu.co

# --- Job selection (comma-separated; default: all registered jobs) ---
# CRON_JOB_KEYS=
