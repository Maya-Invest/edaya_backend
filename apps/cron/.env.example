RUNTIME=local
NODE_ENV=development
LOG_LEVEL=info

# Local dev — persisted PGlite under repo-root .data/ (gitignored). No Docker required.
# Ephemeral in-memory (tests): DATABASE_URL=pglite
# Real Postgres: DATABASE_URL=postgres://admin:admin@localhost:5432/edaya
DATABASE_URL=pglite:.data/school

# Novu Cloud — when set, cron dispatches notifications and polls delivery status (reconcilePendingDeliveries)
# NOVU_SECRET_KEY=
# NOVU_API_URL=https://eu.api.novu.co
