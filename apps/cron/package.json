{
  "name": "@edaya/cron",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun src/entries/local.ts",
    "dev:worker": "wrangler dev --env-file .dev.vars",
    "start": "node dist/local.js",
    "deploy:worker": "wrangler deploy --env production",
    "deploy:worker:dry-run": "wrangler deploy --env production --dry-run",
    "deploy:worker:staging": "wrangler deploy --env staging",
    "deploy:worker:staging:dry-run": "wrangler deploy --env staging --dry-run",
    "check": "tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "NODE_ENV=test bun test ./tests '--path-ignore-patterns=dist/**'",
    "build": "tsup"
  },
  "dependencies": {
    "@edaya/adaptor-file": "workspace:*",
    "@edaya/adaptor-novu": "workspace:*",
    "@edaya/adaptor-postgres": "workspace:*",
    "@edaya/core": "workspace:*",
    "@electric-sql/pglite": "^0.4.6",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^11.0.7",
    "drizzle-orm": "^0.39.0",
    "pino": "^9.6.0",
    "pino-pretty": "^11.3.0",
    "postgres": "^3.4.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260610.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2",
    "typescript": "^6.0.2",
    "wrangler": "^4.99.0"
  }
}
