{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edaya-api",
  "main": "src/entries/worker.ts",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.txt",
        "**/*.html",
        "**/*.css"
      ],
      "fallthrough": true
    }
  ],
  "alias": {
    "@/runtime/resolve-api-runtime": "./src/runtime/worker/resolve-api-runtime.ts"
  },
  "dev": {
    "port": 9999
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "env": {
    "staging": {
      "name": "edaya-api-staging",
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "b910754e7de344448b7b8b19be5645f1"
        },
        {
          "binding": "HYPERDRIVE_AUTH",
          "id": "1f29cf5c2c8f4f0eb8019aa9d6cd74f5"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "browser": {
        "binding": "BROWSER"
      },
      "routes": [
        {
          "pattern": "staging.api.edayaplus.com",
          "custom_domain": true
        }
      ],
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      },
      "queues": {
        "producers": [
          {
            "binding": "CRON_JOBS",
            "queue": "edaya-cron-jobs-staging"
          }
        ],
        "consumers": [
          {
            "queue": "edaya-cron-jobs-staging",
            "max_batch_size": 10,
            "max_retries": 20,
            "retry_delay": 60
          }
        ]
      },
      "kv_namespaces": [
        {
          "binding": "AUTH_KV",
          "id": "773f350615fc43919078baf225d7c1a9"
        }
      ]
    },
    "prod": {
      "name": "edaya-api-prod",
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "579fd58a69774e838c7060c13bcfa0a8"
        },
        {
          "binding": "HYPERDRIVE_AUTH",
          "id": "551d31cd34964614b1f5b974ac2b0e4e"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "browser": {
        "binding": "BROWSER"
      },
      "routes": [
        {
          "pattern": "api.edayaplus.com",
          "custom_domain": true
        }
      ],
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      },
      "queues": {
        "producers": [
          {
            "binding": "CRON_JOBS",
            "queue": "edaya-cron-jobs-prod"
          }
        ],
        "consumers": [
          {
            "queue": "edaya-cron-jobs-prod",
            "max_batch_size": 10,
            "max_retries": 20,
            "retry_delay": 60
          }
        ]
      },
      "kv_namespaces": [
        {
          "binding": "AUTH_KV",
          "id": "6b05cc9701e04c4993d5cf376fbae09e"
        }
      ]
    }
  },
  "keep_vars": true
}
