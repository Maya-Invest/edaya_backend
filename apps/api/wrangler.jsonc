{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker runtime only (`RUNTIME=worker`): optional `bun dev:worker:staging` and deploy.
  // Local dev (`bun dev`) uses `.env` + PGlite/SQLite/local-files — not this file.
  // See docs/reference/runtime-boundaries.md.
  "name": "edaya-api",
  "main": "src/entries/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.txt", "**/*.html"],
      "fallthrough": true
    }
  ],
  "alias": {
    "@/runtime/resolve-api-runtime": "./src/runtime/worker/resolve-api-runtime.ts"
  },
  "dev": {
    "port": 9999
  },
  //
  // Optional worker smoke: `bun dev:worker:staging` (staging Hyperdrive + R2).
  // Hyperdrive + R2 bindings live under env.staging / env.production only (no root Hyperdrive).
  // Deploy secrets: see secrets.staging.json.example / secrets.prod.json.example
  // Hyperdrive local origin for wrangler dev: CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in `.dev.vars`
  // Scheduled cron heartbeat — see docs/reference/cron-runtimes.md
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "CRON_JOBS",
        "queue": "edaya-cron-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "edaya-cron-jobs",
        "max_batch_size": 10,
        "max_retries": 3
      }
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "env": {
    // Production (`wrangler deploy --env production`):
    "production": {
      "name": "edaya-api-prod",
      "vars": {
        "NODE_ENV": "production",
        "LOG_LEVEL": "info",
        "RUNTIME": "worker",
        "BETTER_AUTH_URL": "https://api-prod.edaya.softilab.dev",
        "TRUSTED_ORIGINS": "https://app-prod.edaya.softilab.dev",
        "COOKIE_DOMAIN": "softilab.dev",
        "ALLOW_PUBLIC_SCHOOL_REGISTRATION": "true",
        "R2_BUCKET_NAME": "edaya-files-production"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "c65edec7dba54f01a45d2d5c2f95e0a5"
        }
      ],
      "routes": [
        {
          "pattern": "api-prod.edaya.softilab.dev",
          "custom_domain": true
        }
      ],
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      },
      "queues": {
        "producers": [
          {
            "binding": "CRON_JOBS",
            "queue": "edaya-cron-jobs-prod"
          }
        ],
        "consumers": [
          {
            "queue": "edaya-cron-jobs-prod",
            "max_batch_size": 10,
            "max_retries": 3
          }
        ]
      }
    },
    // Staging (`wrangler deploy --env staging`):
    "staging": {
      "name": "edaya-api-staging",
      // Replace with staging Hyperdrive config ID (Neon staging branch) before first deploy.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "c6b9a94e449647d78f7c49591ba301e6"
        }
      ],
      "vars": {
        "NODE_ENV": "production",
        "LOG_LEVEL": "info",
        "RUNTIME": "worker",
        "BETTER_AUTH_URL": "https://api-staging.edaya.softilab.dev",
        "TRUSTED_ORIGINS": "https://app-staging.edaya.softilab.dev",
        "COOKIE_DOMAIN": "softilab.dev",
        "ALLOW_PUBLIC_SCHOOL_REGISTRATION": "true",
        "REQUIRE_EMAIL_VERIFICATION": "false",
        "R2_BUCKET_NAME": "edaya-files-staging"
      },
      "routes": [
        {
          "pattern": "api-staging.edaya.softilab.dev",
          "custom_domain": true
        }
      ],
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      },
      "queues": {
        "producers": [
          {
            "binding": "CRON_JOBS",
            "queue": "edaya-cron-jobs-staging"
          }
        ],
        "consumers": [
          {
            "queue": "edaya-cron-jobs-staging",
            "max_batch_size": 10,
            "max_retries": 3
          }
        ]
      }
    }
  }
}
