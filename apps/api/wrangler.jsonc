{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edaya-api",
  "main": "src/entries/worker.ts",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.txt",
        "**/*.html",
        "**/*.css"
      ],
      "fallthrough": true
    }
  ],
  "alias": {
    "@/runtime/resolve-api-runtime": "./src/runtime/worker/resolve-api-runtime.ts"
  },
  "dev": {
    "port": 9999
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "env": {
    "staging": {
      "name": "edaya-api-staging",
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "c6b9a94e449647d78f7c49591ba301e6"
        },
        {
          "binding": "HYPERDRIVE_AUTH",
          "id": "e08656297f69446c8eea3d1ded0268d5"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "browser": {
        "binding": "BROWSER"
      },
      "vars": {
        "NODE_ENV": "production",
        "LOG_LEVEL": "info",
        "RUNTIME": "worker",
        "PHONE_AUTH_MODE": "disabled",
        "PHONE_SMS_ROUTES": "[{\"prefix\":\"+225\",\"provider\":\"africas_talking\"}]",
        "AFRICAS_TALKING_SANDBOX": "false",
        "STAGING_MAINTENANCE": "false",
        "STAGING_PAUSE_JOBS": "false",
        "TRUSTED_ORIGINS": "https://staging.app.edayaplus.com,https://staging.admin.edayaplus.com",
        "WEBAPP_ORIGIN": "https://staging.app.edayaplus.com",
        "REQUIRE_EMAIL_VERIFICATION": "true",
        "EMAIL_FROM": "EDAYA <noreply@edayaplus.com>",
        "EMAIL_TRANSPORT": "cloudflare",
        "API_ORIGIN": "https://staging.api.edayaplus.com",
        "ALLOW_PUBLIC_SCHOOL_REGISTRATION": "true",
        "ACCOUNT_INVITATIONS_ENABLED": "true",
        "PROFILE_PHOTO_MAX_BYTES": "1048576",
        "PLATFORM_BOOTSTRAP_EMAILS": "",
        "R2_BUCKET_NAME": "edaya-files-staging"
      },
      "routes": [
        {
          "pattern": "staging.api.edayaplus.com",
          "custom_domain": true
        }
      ],
      "triggers": {
        "crons": [
          "0 * * * *"
        ]
      },
      "queues": {
        "producers": [
          {
            "binding": "CRON_JOBS",
            "queue": "edaya-cron-jobs-staging"
          }
        ],
        "consumers": [
          {
            "queue": "edaya-cron-jobs-staging",
            "max_batch_size": 10,
            "max_retries": 20,
            "retry_delay": 60
          }
        ]
      },
      "kv_namespaces": [
        {
          "binding": "AUTH_KV",
          "id": "5a94d81b83d54a3cb5210f8f4e027d02"
        }
      ]
    },
    "prod": {
      "name": "edaya-api-prod",
      "vars": {
        "NODE_ENV": "production",
        "LOG_LEVEL": "info",
        "RUNTIME": "worker",
        "PHONE_AUTH_MODE": "disabled",
        "PHONE_SMS_ROUTES": "[{\"prefix\":\"+225\",\"provider\":\"africas_talking\"}]",
        "AFRICAS_TALKING_SANDBOX": "false",
        "TRUSTED_ORIGINS": "https://app.edayaplus.com,https://admin.edayaplus.com",
        "WEBAPP_ORIGIN": "https://app.edayaplus.com",
        "REQUIRE_EMAIL_VERIFICATION": "true",
        "EMAIL_FROM": "EDAYA <noreply@edayaplus.com>",
        "EMAIL_TRANSPORT": "cloudflare",
        "API_ORIGIN": "https://api.edayaplus.com",
        "ALLOW_PUBLIC_SCHOOL_REGISTRATION": "true",
        "ACCOUNT_INVITATIONS_ENABLED": "true",
        "PROFILE_PHOTO_MAX_BYTES": "1048576",
        "PLATFORM_BOOTSTRAP_EMAILS": "",
        "R2_BUCKET_NAME": "edaya-files-production"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "c65edec7dba54f01a45d2d5c2f95e0a5"
        },
        {
          "binding": "HYPERDRIVE_AUTH",
          "id": "d355a17a3bcc4369b3394f9f86f2ee47"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "browser": {
        "binding": "BROWSER"
      },
      "routes": [
        {
          "pattern": "api.edayaplus.com",
          "custom_domain": true
        }
      ],
      "triggers": {
        "crons": [
          "0 * * * *"
        ]
      },
      "queues": {
        "producers": [
          {
            "binding": "CRON_JOBS",
            "queue": "edaya-cron-jobs-prod"
          }
        ],
        "consumers": [
          {
            "queue": "edaya-cron-jobs-prod",
            "max_batch_size": 10,
            "max_retries": 20,
            "retry_delay": 60
          }
        ]
      },
      "kv_namespaces": [
        {
          "binding": "AUTH_KV",
          "id": "5381bed94af74b478886d49ef52f1a52"
        }
      ]
    }
  }
}
