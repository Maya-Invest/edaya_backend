{
  "name": "@edaya/api",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun --no-env-file --watch src/entries/local.ts ../../package/adaptor-postgres/src/postgres-store.ts",
    "cron:local": "bun --no-env-file src/entries/cron-local.ts",
    "dev:worker": "bun --no-env-file ../../tooling/repo/dev/start-worker-dev.ts",
    "deploy:staging:dry-run": "bun x wrangler deploy --env staging --dry-run",
    "deploy:production:dry-run": "bun x wrangler deploy --env prod --dry-run",
    "check": "bun x --bun tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "lint": "bun x --bun eslint src tests",
    "lint:fix": "bun x --bun eslint src tests --fix",
    "test": "NODE_ENV=test bun test ./tests ./src --timeout 120000 --path-ignore-patterns '**/*.integration.test.ts' --preload ../../tooling/test-support/unit-preload.ts",
    "test:integration": "NODE_ENV=test bun tests/scripts/run-integration.ts"
  },
  "dependencies": {
    "@edaya/account": "workspace:*",
    "@edaya/adaptor-account": "workspace:*",
    "@edaya/adaptor-auth": "workspace:*",
    "@edaya/adaptor-auth-better-auth": "workspace:*",
    "@edaya/adaptor-docs": "workspace:*",
    "@edaya/adaptor-import-format": "workspace:*",
    "@edaya/adaptor-local-fs": "workspace:*",
    "@edaya/adaptor-notify": "workspace:*",
    "@edaya/adaptor-postgres": "workspace:*",
    "@edaya/adaptor-r2": "workspace:*",
    "@edaya/adaptor-sms": "workspace:*",
    "@edaya/authorization": "workspace:*",
    "@edaya/core": "workspace:*",
    "@edaya/messaging": "workspace:*",
    "@edaya/service": "workspace:*",
    "@electric-sql/pglite": "^0.4.6",
    "@hono/node-server": "^1.14.1",
    "@hono/zod-openapi": "^0.16.4",
    "@maya-invest/edaya-api-client": "workspace:*",
    "@scalar/hono-api-reference": "^0.8.8",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^11.0.7",
    "drizzle-orm": "^0.39.0",
    "hono": "^4.7.9",
    "hono-pino": "^0.3.0",
    "jose": "^6.1.3",
    "jsonc-parser": "3.3.1",
    "parse5": "8.0.0",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "pino-pretty": "^11.3.0",
    "postgres": "^3.4.5",
    "stoker": "^1.4.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260610.0",
    "@edaya/fixtures": "workspace:*",
    "@edaya/repo": "workspace:*",
    "@edaya/seeding": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.15.5",
    "typescript": "^6.0.2",
    "wrangler": "^4.153.0"
  }
}
