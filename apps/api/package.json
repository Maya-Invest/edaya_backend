{
  "name": "@edaya/api",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/entries/node.ts",
    "dev:worker": "wrangler dev --env-file .dev.vars",
    "start": "node dist/node.js",
    "deploy:worker": "wrangler deploy --env production",
    "deploy:worker:dry-run": "wrangler deploy --env production --dry-run",
    "deploy:worker:staging": "wrangler deploy --env staging",
    "deploy:worker:staging:dry-run": "wrangler deploy --env staging --dry-run",
    "check": "tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "NODE_ENV=test bun test ./tests '--path-ignore-patterns=dist/**'",
    "build": "tsup",
    "export-openapi": "bun src/scripts/export-openapi.ts",
    "generate-api-client": "bun src/scripts/generate-api-client.ts"
  },
  "dependencies": {
    "@edaya/adaptor-novu": "workspace:*",
    "@edaya/adaptor-postgres": "workspace:*",
    "@edaya/betterauth-d1-migrations": "workspace:*",
    "@edaya/core": "workspace:*",
    "@electric-sql/pglite": "^0.4.6",
    "@hono/graphql-server": "^0.7.0",
    "@hono/node-server": "^1.14.1",
    "@hono/zod-openapi": "^0.16.4",
    "@scalar/hono-api-reference": "^0.8.8",
    "better-auth": "^1.6.16",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^11.0.7",
    "drizzle-orm": "^0.39.0",
    "graphql": "^16.9.0",
    "hono": "^4.7.9",
    "hono-pino": "^0.3.0",
    "pino": "^9.6.0",
    "pino-pretty": "^11.3.0",
    "postgres": "^3.4.4",
    "stoker": "^1.4.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260610.0",
    "@edaya/dev-fixtures": "workspace:*",
    "@edaya/seeding": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2",
    "typescript": "^6.0.2",
    "wrangler": "^4.99.0"
  }
}
