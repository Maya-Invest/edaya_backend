{
  "name": "@edaya/api",
  "type": "module",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/entries/node.ts",
    "dev:worker": "wrangler dev",
    "seed": "tsx src/scripts/seed.ts",
    "start": "node dist/node.js",
    "deploy:worker": "wrangler deploy",
    "check": "tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "cross-env NODE_ENV=test bun test ./tests '--path-ignore-patterns=dist/**'",
    "build": "tsup",
    "export-openapi": "tsx src/scripts/export-openapi.ts",
    "generate-api-client": "tsx src/scripts/generate-api-client.ts"
  },
  "dependencies": {
    "@edaya/adaptor-betterauth": "workspace:*",
    "@edaya/adaptor-postgres": "workspace:*",
    "@edaya/core": "workspace:*",
    "@edaya/dev-fixtures": "workspace:*",
    "@electric-sql/pglite": "^0.4.6",
    "@hono/node-server": "^1.14.1",
    "@hono/zod-openapi": "^0.16.4",
    "@scalar/hono-api-reference": "^0.8.8",
    "better-auth": "^1.1.21",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^11.0.7",
    "drizzle-orm": "^0.39.0",
    "hono": "^4.7.9",
    "hono-pino": "^0.3.0",
    "pino": "^9.6.0",
    "pino-pretty": "^11.3.0",
    "postgres": "^3.4.4",
    "stoker": "^1.4.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260610.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.17",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.99.0"
  }
}
