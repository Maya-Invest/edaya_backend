# -----------------------------------------------------------------------------
# Edaya API — Cloudflare / Wrangler secrets (+ wrangler-only local overrides)
# Copy to `.dev.vars` (gitignored). Loaded by `wrangler dev --env-file` and deploy secrets.
# NOT loaded by `bun dev` — use `apps/api/.env` for local process runtime.
# Non-secret worker defaults: `wrangler.jsonc` [env.*.vars]
# Bulk deploy secrets: secrets.json.example → secrets.staging.json / secrets.prod.json
# -----------------------------------------------------------------------------

# --- Wrangler local smoke overrides (optional; staging [vars] apply when --env staging) ---
# NODE_ENV=development
# LOG_LEVEL=info
# RUNTIME=worker
# API_ORIGIN=http://localhost:9999
# TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173
# ALLOW_PUBLIC_SCHOOL_REGISTRATION=true

# --- Account secrets (preserve the existing values) ---
BETTER_AUTH_SECRET=REPLACE_WITH_EXISTING_AT_LEAST_32_CHARACTER_SECRET
ACCOUNT_SECURITY_KEYS={"v1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}
ACCOUNT_SECURITY_KEY_VERSION=v1

# --- Hyperdrive local origin (wrangler dev only; must match --env Neon branch) ---
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://user:password@host/neondb?sslmode=require
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_AUTH=postgresql://edaya_identity:password@host/edaya_identity?sslmode=require

# --- R2 (required on RUNTIME=worker; also used by `bun repo smoke-test r2`) ---
# R2_BUCKET_NAME=edaya-files-staging
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- In-process notify (Worker Email binding + optional FCM) ---
# EMAIL_TRANSPORT=cloudflare
# EMAIL_FROM=EDAYA <noreply@edayaplus.com>
# SMS_TRANSPORT=unimplemented
# FCM_SERVICE_ACCOUNT_JSON=

# --- Document rendering (in-process `@edaya/adaptor-docs`) ---
# GOTENBERG_URL=http://localhost:3000   # Miniflare does not implement BROWSER.quickAction
#   wrangler.jsonc already binds BROWSER; deployed Workers use it without remote
#   wrangler dev real PDFs: GOTENBERG_URL or `"remote": true` on the browser binding
# DOCS_RENDER_ON_PUBLISH=true

# --- Optional ---
# WEBAPP_ORIGIN=https://staging.app.edayaplus.com
# ACCOUNT_INVITATIONS_ENABLED=true
# PROFILE_PHOTO_MAX_BYTES=1048576
# STAGING_NOTIFICATION_EMAILS=

# --- Not used in Wrangler / worker ---
# PORT= / DATABASE_URL=pglite: / RUN_MIGRATIONS_ON_STARTUP= / LOCAL_FILES_* / CRON_JOB_KEYS=
#   → local only: `apps/api/.env`
# GRAPHQL_* / LOCAL_FILES_PORT=
#   → local only

# Upload deploy secrets (from apps/api):
#   cp secrets.json.example secrets.staging.json
#   bunx wrangler secret bulk secrets.staging.json --env staging
