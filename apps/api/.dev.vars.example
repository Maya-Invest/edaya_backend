# -----------------------------------------------------------------------------
# Edaya API — Cloudflare / Wrangler secrets only
# Copy to `.dev.vars` (gitignored). Loaded by `wrangler dev --env-file` and `wrangler secret bulk`.
# NOT loaded by `bun dev` — local process runtime uses `apps/api/.env` only.
# Non-secret defaults live in `wrangler.jsonc` [vars].
# See docs/reference/runtime-boundaries.md.
# -----------------------------------------------------------------------------

"NODE_ENV": "development",
"LOG_LEVEL": "info",
"RUNTIME": "worker",
"BETTER_AUTH_URL": "http://localhost:9999",
"TRUSTED_ORIGINS": "http://localhost:5173,http://localhost:4173",
"R2_BUCKET_NAME": "edaya-files-dev",
"ALLOW_PUBLIC_SCHOOL_REGISTRATION": "true"

# --- Required ---

BETTER_AUTH_SECRET=dev-secret-change-in-production

# --- Hyperdrive (worker smoke) ---
# Origin Postgres for the Hyperdrive binding in wrangler.jsonc.
# Prefer explicit env: `cd apps/api && wrangler dev --env staging --env-file .dev.vars`
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://user:password@host/neondb?sslmode=require

# --- R2 file storage (required on RUNTIME=worker) ---
# Buckets: edaya-files-staging | edaya-files-production (per wrangler [vars])
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=edaya-files-staging

# --- Novu (deployed workers) ---
# Local dev + staging share the dev Novu key (set in apps/api/.env for `bun dev`).
# Production uses a separate key — set via `wrangler secret put` / secrets.prod.json.
# NOVU_SECRET_KEY=
# NOVU_API_URL=https://eu.api.novu.co
# NOVU_WEBHOOK_SECRET=whsec_...

# --- Optional ---

# GRANTS_CACHE_TTL_MS=300000

# --- Wrangler secrets (deployed workers only; run from apps/api) ---
# Templates:
#   cp secrets.staging.json.example secrets.staging.json
#   cp secrets.prod.json.example secrets.prod.json
# Upload:
#   bunx wrangler secret bulk secrets.staging.json --env staging
#   bunx wrangler secret bulk secrets.prod.json --env production
# Use unique secrets per environment (never reuse staging values in production).

# --- One-time setup before worker smoke / deploy ---
# bun run db:migrate:staging      # Neon staging branch
# bun run db:migrate:production   # Neon production branch
