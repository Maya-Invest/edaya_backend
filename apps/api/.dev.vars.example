# Wrangler-local secrets only. Copy to .dev.vars (gitignored).
# bun --filter @edaya/api dev:worker loads config.staging.jsonc + this file.
# bun dev uses config.local.jsonc + .env instead.
# This file does not upload secrets to deployed Workers.
BETTER_AUTH_SECRET=REPLACE_WITH_EXISTING_AT_LEAST_32_CHARACTER_SECRET
ACCOUNT_SECURITY_KEYS={"v1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
# Wrangler-only local Hyperdrive origin overrides (match the staging database branch).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://user:password@host/neondb?sslmode=require
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_AUTH=postgresql://edaya_identity:password@host/edaya_identity?sslmode=require
# Optional providers; omit unused entries. FCM is required by coordinated staging releases.
# FCM_SERVICE_ACCOUNT_JSON=
# AFRICAS_TALKING_API_KEY=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Keep mode/routes/usernames/sender IDs/WhatsApp IDs/templates in config.staging.jsonc.
# Copy secrets.json.example to secrets.staging.json or secrets.prod.json for deployment.
# Remove unused optional provider entries from that JSON before uploading.
# Preserve existing account secrets and keyrings. ACCOUNT_SECURITY_KEYS is an encoded
# JSON object mapping version to a base64-encoded 32-byte key. FCM is encoded JSON too.
# From apps/api: bunx wrangler secret bulk secrets.staging.json --env staging
# From repo root: bun repo ops vars push staging (configuration update only).
