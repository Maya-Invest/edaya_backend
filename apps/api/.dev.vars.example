# -----------------------------------------------------------------------------
# Edaya API — Cloudflare / Wrangler secrets (+ wrangler-only local overrides)
# Copy to `.dev.vars` (gitignored). Loaded by `wrangler dev --env-file` and deploy secrets.
# NOT loaded by `bun dev` — use `apps/api/.env` for local process runtime.
# Non-secret worker defaults: `wrangler.jsonc` [env.*.vars]
# Bulk deploy secrets: secrets.json.example → secrets.staging.json / secrets.prod.json
# -----------------------------------------------------------------------------

# --- Wrangler local smoke overrides (optional; staging [vars] apply when --env staging) ---
# NODE_ENV=development
# LOG_LEVEL=info
# RUNTIME=worker
# BETTER_AUTH_URL=http://localhost:9999
# TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173
# ALLOW_PUBLIC_SCHOOL_REGISTRATION=true

# --- Required secret ---
BETTER_AUTH_SECRET=dev-secret-change-in-production

# --- Hyperdrive local origin (wrangler dev only; must match --env Neon branch) ---
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://user:password@host/neondb?sslmode=require
# Same origin for auth (cache-disabled binding in deployed Workers; local wrangler ignores Hyperdrive cache)
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_AUTH=postgresql://user:password@host/neondb?sslmode=require

# --- R2 (required on RUNTIME=worker; also used by `bun repo smoke-test r2`) ---
# R2_BUCKET_NAME=edaya-files-staging
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- Novu (staging: dev key; production: separate key in secrets.prod.json) ---
# NOVU_SECRET_KEY=
# NOVU_API_URL=https://eu.api.novu.co
# NOVU_WEBHOOK_SECRET=whsec_...

# --- Optional ---
# GRANTS_CACHE_TTL_MS=300000
# COOKIE_DOMAIN=edaya.app
# WEBAPP_ORIGIN=https://staging.staff.edaya.app
# ACCOUNT_INVITATIONS_ENABLED=true
# REQUIRE_EMAIL_VERIFICATION=false

# --- Not used in Wrangler / worker ---
# PORT= / DATABASE_URL=pglite: / RUN_MIGRATIONS_ON_STARTUP= / LOCAL_FILES_* / CRON_JOB_KEYS= / AUTH_EMAIL_LOG_OTP=
#   → local only: `apps/api/.env`
# GRAPHQL_* / LOCAL_FILES_PORT=
#   → local only

# Upload deploy secrets (from apps/api):
#   cp secrets.json.example secrets.staging.json
#   bunx wrangler secret bulk secrets.staging.json --env staging
