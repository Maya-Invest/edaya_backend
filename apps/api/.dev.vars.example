BETTER_AUTH_SECRET=dev-secret-change-in-production

# Production Worker secrets (Cloudflare dashboard or `wrangler secret put --env production`):
#   wrangler secret put BETTER_AUTH_SECRET --env production
# Optional:
#   wrangler secret put SYSTEM_ACTOR_SECRET --env production

# Hyperdrive origin DB for `bun run dev:worker`.
# Wrangler reads this via --env-file (see package.json dev:worker script).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://user:password@host/neondb?sslmode=require

# Optional Node / wrangler fallback when Hyperdrive binding is unavailable
# DATABASE_URL=postgres://admin:admin@localhost:5432/edaya

# Optional local SQLite file for Better Auth on the Node runtime
# AUTH_DATABASE_PATH=.data/auth.sqlite

# Optional: run once before first wrangler dev
# bun run db:migrate:dev        # Neon school DB + local D1 auth
# bun run db:migrate:auth:remote # production D1 auth only

# Dev bootstrap — enabled by default when NODE_ENV=development.
# POST /core/onboarding/register-school (authenticated, unlinked users only)
# ALLOW_PUBLIC_SCHOOL_REGISTRATION=true
