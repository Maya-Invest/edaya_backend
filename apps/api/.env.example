RUNTIME=node
NODE_ENV=development
PORT=9999
LOG_LEVEL=info

# Local dev — persisted PGlite + auth SQLite under repo-root .data/ (gitignored). No Docker required.
# Ephemeral in-memory (tests): DATABASE_URL=pglite
# Real Postgres: DATABASE_URL=postgres://admin:admin@localhost:5432/edaya
DATABASE_URL=pglite:.data/school

AUTH_DATABASE_PATH=.data/auth.sqlite

BETTER_AUTH_SECRET=dev-secret-change-in-production
BETTER_AUTH_URL=http://localhost:9999
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173

# Staging / production split-domain example:
# BETTER_AUTH_URL=https://api.edaya.com
# TRUSTED_ORIGINS=https://app.edaya.com
# COOKIE_DOMAIN=edaya.com

# Service account API key for GraphiQL auto-auth (optional).
# Use the `seedingApiKey` from the school profile in @edaya/dev-fixtures.
# GRAPHQL_DEV_API_KEY=sk_live_dev_edaya_central_seeding_integration_key

# Optional remote target when different from BETTER_AUTH_URL
# SEED_API_URL=http://localhost:9999

# Dev bootstrap — enabled by default when NODE_ENV=development.
# POST /core/onboarding/register-school (authenticated, unlinked users only)
# ALLOW_PUBLIC_SCHOOL_REGISTRATION=true

# GraphiQL playground at /graphiql (default: on when NODE_ENV != production)
# GRAPHQL_GRAPHIQL=true
# Optional auto-auth for GraphiQL (Bearer header injected locally):
# GRAPHQL_DEV_API_KEY=sk_live_dev_edaya_central_seeding_integration_key
# Webapp link shown in GraphiQL auth banner:
# GRAPHIQL_WEBAPP_ORIGIN=http://localhost:5173
# Default email prefilled in GraphiQL login form (seeded director staff):
# GRAPHIQL_DEFAULT_EMAIL=c.moreau@school.edu
