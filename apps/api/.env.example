RUNTIME=node
NODE_ENV=development
PORT=9999
LOG_LEVEL=info

# In-memory Postgres for local dev (no Docker). Use a real URL for persistence:
# DATABASE_URL=postgres://admin:admin@localhost:5432/edaya
DATABASE_URL=pglite

BETTER_AUTH_SECRET=dev-secret-change-in-production
BETTER_AUTH_URL=http://localhost:9999
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173

# Dev seed — auto-runs on startup with pglite/memory (default). Set false to disable.
# SEED_ON_START=true
#
# Seeded Better Auth dev accounts (password: DevPassword1!):
#   c.moreau@school.edu  → staff st5
#   m.dupont@school.edu  → staff st1
#   c.laurent@mail.com   → guardian g1

# Optional — required only for /core/system/commands/*
# SYSTEM_ACTOR_SECRET=
