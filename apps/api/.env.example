# -----------------------------------------------------------------------------
# Edaya API — local process runtime (`bun dev`)
# Copy to `.env` (gitignored). Local dev uses `.env` only.
# Worker / Wrangler: `wrangler.jsonc` [vars] + `.dev.vars` + secrets.*.json
# See docs/reference/runtime-boundaries.md and EnvSchema (runtime/shared/env/schema.ts).
# -----------------------------------------------------------------------------

# --- Runtime ---
RUNTIME=local
NODE_ENV=development
PORT=9999
LOG_LEVEL=debug

# --- School database (identity has its own database) ---
DATABASE_URL=pglite:.data/school
RUN_MIGRATIONS_ON_STARTUP=true

# --- Central identity ---
API_ORIGIN=http://localhost:9999
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Onboarding & invitations ---
# ALLOW_PUBLIC_SCHOOL_REGISTRATION=true   # default: true when NODE_ENV=development
# WEBAPP_ORIGIN=http://localhost:5173     # invitation links; defaults to first TRUSTED_ORIGINS
# ACCOUNT_INVITATIONS_ENABLED=true        # default: true
# PROFILE_PHOTO_MAX_BYTES=1048576         # JPEG portrait admission cap (1 MiB)

# --- Authorization ---
# Cross-request authorization caching is disabled for immediate revocation.
# Comma-separated identity emails allowed to bootstrap the first platform operators.
# PLATFORM_BOOTSTRAP_EMAILS=platform.operator@edaya.test

# --- Notifications (in-process `@edaya/adaptor-notify` on the school API) ---
# EMAIL_TRANSPORT=log             # explicit override: omit real email delivery
# EMAIL_FROM=EDAYA <noreply@edayaplus.com>
# SMS_TRANSPORT=log
# FCM_SERVICE_ACCOUNT_JSON=

# --- Local authentication email (also used by bun run dev:test) ---
# With both credentials set, OTP emails send automatically unless EMAIL_TRANSPORT=log.
# Requires a sender domain enabled in Cloudflare Email Sending and an email-send API token.
# Worker deployments continue to use their EMAIL binding.
# CLOUDFLARE_EMAIL_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_API_TOKEN=

# --- Scheduled cron (one-shot: `bun cron:local`) ---
# CRON_JOB_KEYS=processDueNotifications,reconcilePendingDeliveries

# --- File storage (`bun tooling/repo/dev/local-files.ts`, started by `bun dev`) ---
# LOCAL_FILES_URL=http://localhost:9200
# LOCAL_FILES_ROOT=.data/files
# LOCAL_FILES_SECRET=dev-local-files-secret
# LOCAL_FILES_PORT=9200                   # local-files service only (not in EnvSchema)

# --- Document rendering (in-process `@edaya/adaptor-docs`) ---
# GOTENBERG_URL=http://localhost:3000   # optional; else Chrome print-to-pdf if installed, else a tiny stub
#   docker run --rm -p 3000:3000 gotenberg/gotenberg:8
# CHROME_PATH=                          # optional explicit Chrome/Chromium binary; blank keeps the stub
# DOCS_RENDER_ON_PUBLISH=true             # background PDF on publishReportCardResult

# --- GraphiQL (local dev only; not in EnvSchema) ---
# GRAPHQL_GRAPHIQL=true
# GRAPHQL_DEV_API_KEY=                    # @edaya/fixtures seedingApiKey
# GRAPHIQL_WEBAPP_ORIGIN=http://localhost:5173
# GRAPHIQL_DEFAULT_EMAIL=c.moreau@school.edu

# --- Not used on RUNTIME=local (documented for cross-reference) ---
# R2_* → worker: wrangler.jsonc [vars] + secrets / `.dev.vars`
# Remote Postgres → worker: Hyperdrive binding (not .env)

# Account storage stays separate; auth and school share API_ORIGIN.
AUTH_DATABASE_URL=pglite:.data/identity
BETTER_AUTH_SECRET=local-development-account-secret-at-least-32-characters
PHONE_AUTH_MODE=disabled
