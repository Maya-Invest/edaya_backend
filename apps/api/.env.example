# -----------------------------------------------------------------------------
# Edaya API — local process runtime (`bun dev`)
# Copy to `.env` (gitignored). `.dev.vars` is loaded afterward for secrets.
# Worker profile (`bun dev:worker-local`) uses `wrangler.jsonc` + `.dev.vars` instead.
# See docs/reference/runtime-boundaries.md for the adapter matrix.
# -----------------------------------------------------------------------------

# --- Runtime ---
RUNTIME=local
NODE_ENV=development
PORT=9999
LOG_LEVEL=info

# --- School + auth database (persisted PGlite on local profile; auth uses `auth` schema) ---
DATABASE_URL=pglite:.data/school
RUN_MIGRATIONS_ON_STARTUP=true

# --- Better Auth ---
BETTER_AUTH_SECRET=dev-secret-change-in-production
BETTER_AUTH_URL=http://localhost:9999
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173

# Split-domain example (staging / production — set in wrangler.jsonc [vars], not .env):
# COOKIE_DOMAIN=softilab.dev
# BETTER_AUTH_URL=https://api-staging.edaya.softilab.dev
# TRUSTED_ORIGINS=https://app-staging.edaya.softilab.dev

# --- Onboarding & invitations ---
# ALLOW_PUBLIC_SCHOOL_REGISTRATION=true   # default: true when NODE_ENV=development
# WEBAPP_ORIGIN=http://localhost:5173     # invitation accept links; defaults to first TRUSTED_ORIGINS
# ACCOUNT_INVITATIONS_ENABLED=true        # default: true

# --- Authorization ---
# GRANTS_CACHE_TTL_MS=300000

# --- Novu (notifications + auth emails + cron delivery) ---
# NOVU_SECRET_KEY=
# NOVU_API_URL=https://eu.api.novu.co
# NOVU_WEBHOOK_SECRET=whsec_...           # POST /webhooks/notification-delivery
# REQUIRE_EMAIL_VERIFICATION=true         # default: true when NOVU_SECRET_KEY is set
# AUTH_EMAIL_LOG_OTP=true                 # log OTP / verify URLs in dev (default: true)
# Apply workflows once: bun novu:bootstrap:apply

# --- Scheduled cron jobs (local one-shot: `bun dev:cron`) ---
# CRON_JOB_KEYS=processDueNotifications,reconcilePendingDeliveries
# Worker cron uses wrangler heartbeat + CRON_JOBS queue — see docs/reference/cron-runtimes.md

# --- File storage: local dev service (started automatically by `bun dev`) ---
# LOCAL_FILES_URL=http://localhost:9200
# LOCAL_FILES_ROOT=.data/files
# LOCAL_FILES_PORT=9200                   # local-files service only (not in EnvSchema)
# LOCAL_FILES_SECRET=                     # defaults to BETTER_AUTH_SECRET

# R2 credentials belong in `.dev.vars` for `bun dev:worker-local`, not `bun dev`.

# --- GraphiQL (local dev only; not validated by EnvSchema) ---
# GRAPHQL_GRAPHIQL=true                   # default: enabled when NODE_ENV≠production
# GRAPHQL_DEV_API_KEY=                    # auto-inject Bearer; use @edaya/fixtures seedingApiKey
# GRAPHIQL_WEBAPP_ORIGIN=http://localhost:5173
# GRAPHIQL_DEFAULT_EMAIL=c.moreau@school.edu

# --- Production promotion checklist (worker — not .env) ---
# 1. bun run db:migrate:hyperdrive
# 2. Set wrangler secrets (see apps/api/.dev.vars.example)
# 3. bun run deploy:api:staging && bun run smoke:staging
# 4. bun run deploy:api && smoke production manually
