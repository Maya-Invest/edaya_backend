# Local API secrets. Copy to .env (gitignored).
# Non-secret settings live in config.local.jsonc; explicit shell values override them.
# API, cron, local files and internal CI fixtures share the loader; test identity stays isolated.
BETTER_AUTH_SECRET=local-development-account-secret-at-least-32-characters
# Optional explicit keyring; local development otherwise derives a key from the secret.
# ACCOUNT_SECURITY_KEYS={"v1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}
# LOCAL_FILES_SECRET=dev-local-files-secret
# Optional real auth email: account ID / sender in config.local.jsonc.
# CLOUDFLARE_EMAIL_API_TOKEN=
# Optional push; omit when unused (do not assign an empty value).
# FCM_SERVICE_ACCOUNT_JSON=
# Phone OTP: configure mode, routes, sender IDs and templates in config.local.jsonc.
# AFRICAS_TALKING_API_KEY=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
