{
  "name": "@edaya/identity",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/entries/local.ts",
    "start": "bun src/entries/local.ts",
    "dev:worker": "wrangler dev --env staging --env-file .dev.vars",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env prod",
    "check": "tsc --noEmit",
    "quality": "bun run lint && bun run check",
    "lint": "eslint src tests testing",
    "lint:fix": "eslint src tests testing --fix",
    "test": "NODE_ENV=test bun test ./tests --timeout 120000",
    "build": "tsc --noEmit",
    "dev:test": "NODE_ENV=test bun --no-env-file src/entries/testing.ts"
  },
  "dependencies": {
    "@edaya/adaptor-auth": "workspace:*",
    "@electric-sql/pglite": "^0.4.6",
    "@hono/node-server": "^1.14.1",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.39.0",
    "hono": "^4.7.9",
    "jose": "^6.1.3",
    "pg": "^8.16.3",
    "@maya-invest/edaya-identity-client": "workspace:*",
    "pino": "^9.6.0",
    "pino-pretty": "^11.3.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.4",
    "@edaya/adaptor-account": "workspace:*",
    "@edaya/account": "workspace:*",
    "@edaya/adaptor-auth-better-auth": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260610.0",
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.15.5",
    "typescript": "^6.0.2",
    "wrangler": "^4.99.0"
  }
}
