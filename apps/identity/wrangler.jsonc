{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Top-level name is not a deploy target. Always use `--env staging` or `--env prod`
  // so this cannot overwrite the production Worker (`edaya-identity`).
  "name": "edaya-identity-local",
  "main": "src/entries/worker.ts",
  "alias": { "@maya-invest/edaya-identity-client": "../../package/identity-client/src/index.ts" },
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "dev": {
    "port": 9900
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "env": {
    "staging": {
      "name": "edaya-identity-staging",
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE_AUTH",
          "id": "e08656297f69446c8eea3d1ded0268d5"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "AUTH_KV",
          "id": "5a94d81b83d54a3cb5210f8f4e027d02"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "vars": {
        "NODE_ENV": "production",
        "LOG_LEVEL": "info",
        "RUNTIME": "worker",
        "PHONE_AUTH_MODE": "disabled",
        "PHONE_SMS_ROUTES": "[{\"prefix\":\"+225\",\"provider\":\"africas_talking\"}]",
        "AFRICAS_TALKING_SANDBOX": "false",
        "BETTER_AUTH_URL": "https://staging.identity.api.edayaplus.com",
        "STAGING_MAINTENANCE": "false",
        "STAGING_PAUSE_JOBS": "false",
        "FIRST_PARTY_API_ORIGINS": "https://staging.school.api.edayaplus.com",
        "TRUSTED_ORIGINS": "https://staging.app.edayaplus.com,https://staging.admin.edayaplus.com",
        "WEBAPP_ORIGIN": "https://staging.app.edayaplus.com",
        "REQUIRE_EMAIL_VERIFICATION": "true",
        "EMAIL_FROM": "EDAYA <noreply@edayaplus.com>",
        "EMAIL_TRANSPORT": "cloudflare"
      },
      "routes": [
        {
          "pattern": "staging.identity.api.edayaplus.com",
          "custom_domain": true
        }
      ],
      "triggers": {
        "crons": ["0 * * * *"]
      }
    },
    "prod": {
      "name": "edaya-identity",
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE_AUTH",
          "id": "d355a17a3bcc4369b3394f9f86f2ee47"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "AUTH_KV",
          "id": "5381bed94af74b478886d49ef52f1a52"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "vars": {
        "NODE_ENV": "production",
        "LOG_LEVEL": "info",
        "RUNTIME": "worker",
        "PHONE_AUTH_MODE": "disabled",
        "PHONE_SMS_ROUTES": "[{\"prefix\":\"+225\",\"provider\":\"africas_talking\"}]",
        "AFRICAS_TALKING_SANDBOX": "false",
        "BETTER_AUTH_URL": "https://identity.api.edayaplus.com",
        "FIRST_PARTY_API_ORIGINS": "https://school.api.edayaplus.com",
        "TRUSTED_ORIGINS": "https://app.edayaplus.com,https://admin.edayaplus.com",
        "WEBAPP_ORIGIN": "https://app.edayaplus.com",
        "REQUIRE_EMAIL_VERIFICATION": "true",
        "EMAIL_FROM": "EDAYA <noreply@edayaplus.com>",
        "EMAIL_TRANSPORT": "cloudflare"
      },
      "routes": [
        {
          "pattern": "identity.api.edayaplus.com",
          "custom_domain": true
        }
      ],
      "triggers": {
        "crons": ["0 * * * *"]
      }
    }
  }
}
