# Wrangler-only secrets for `wrangler dev --env staging --env-file .dev.vars`.
# Local `bun repo dev` uses apps/identity/.env (copy from .env.example).

BETTER_AUTH_SECRET=super-secret-placeholder-key-for-local-testing
IDENTITY_DIRECTORY_SECRET=local-directory-secret

# Hyperdrive origin for wrangler dev (must match the bound AUTH database)
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_AUTH=postgresql://user:password@host/neondb?sslmode=require

# Durable Account security keys: JSON map of version to base64 32-byte key. Required in production.
# ACCOUNT_SECURITY_KEYS={"v1":"<base64-32-byte-key>"}
ACCOUNT_SECURITY_KEY_VERSION=v1
AUTH_PROVIDER_GENERATION=better-auth:v1
REQUIRE_PRIVILEGED_TOTP=false
# ACCOUNT_POLICY_URL=https://school.api.edayaplus.com
# TELEGRAM_GATEWAY_TOKEN=<secret>
# WHATSAPP_ACCESS_TOKEN=<secret>
# WHATSAPP_PHONE_NUMBER_ID=<sender-id>
# WHATSAPP_AUTH_TEMPLATE=<approved-authentication-template>
# WHATSAPP_API_VERSION=<pinned-supported-version>
WHATSAPP_TEMPLATE_LANGUAGE=en_US
