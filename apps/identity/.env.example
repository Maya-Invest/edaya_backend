# Durable Account security keys: JSON map of version to base64 32-byte key. Required in production.
# ACCOUNT_SECURITY_KEYS={"v1":"<base64-32-byte-key>"}
ACCOUNT_SECURITY_KEY_VERSION=v1
AUTH_PROVIDER_GENERATION=better-auth:v1
REQUIRE_PRIVILEGED_TOTP=false
