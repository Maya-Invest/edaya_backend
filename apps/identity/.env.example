PORT=9900
AUTH_DATABASE_URL=pglite:.data/identity
BETTER_AUTH_URL=http://localhost:9900
FIRST_PARTY_API_ORIGINS=http://localhost:9999,http://localhost:8787
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5175
WEBAPP_ORIGIN=http://localhost:5173
IDENTITY_DIRECTORY_SECRET=local-directory-secret
BETTER_AUTH_SECRET=super-secret-placeholder-key-for-local-testing
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_FROM=EDAYA <noreply@edayaplus.com>

# Durable Account security keys: JSON map of version to base64 32-byte key. Required in production.
# ACCOUNT_SECURITY_KEYS={"v1":"<base64-32-byte-key>"}
ACCOUNT_SECURITY_KEY_VERSION=v1
AUTH_PROVIDER_GENERATION=better-auth:v1
REQUIRE_PRIVILEGED_TOTP=false
# ACCOUNT_POLICY_URL=https://school.api.edayaplus.com
# Phone rollout: disabled, sms_only (before Meta approval), or whatsapp_first.
PHONE_AUTH_MODE=disabled
PHONE_SMS_ROUTES='[{"prefix":"+225","provider":"africas_talking"}]'
AFRICAS_TALKING_SANDBOX=false
# AFRICAS_TALKING_USERNAME=<account-username>
# AFRICAS_TALKING_API_KEY=<secret>
# AFRICAS_TALKING_SENDER_ID=<approved-CI-sender>
