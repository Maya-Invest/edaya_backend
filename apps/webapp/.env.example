# Vite dev proxy target (bun dev). Leave PUBLIC_API_URL empty to use same-origin /core and /auth via proxy.
API_URL=http://localhost:9999

# Client-side API + Better Auth base URL. Empty in local dev → Vite proxy.
# Production build (Workers static assets):
# PUBLIC_API_URL=https://api.edaya.softilab.dev
# API TRUSTED_ORIGINS must include https://app.edaya.softilab.dev
PUBLIC_API_URL=
