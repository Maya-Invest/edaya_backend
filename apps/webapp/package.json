{
	"name": "@edaya/webapp",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"preview:pages": "wrangler pages dev build",
		"deploy": "bun run build && wrangler pages deploy build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"quality": "bun run lint && bun run check",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"openapi:generate": "openapi-typescript src/lib/api/openapi.json -o src/lib/api/schema.d.ts"
	},
	"dependencies": {
		"@edaya/api-client": "workspace:*",
		"@internationalized/date": "^3.12.2",
		"better-auth": "^1.6.16",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"lucide-svelte": "^1.0.1",
		"openapi-fetch": "^0.17.0",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@types/node": "^25.9.2",
		"autoprefixer": "^10.5.0",
		"openapi-typescript": "^7.13.0",
		"postcss": "^8.5.15",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^3.4.19",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"wrangler": "^4.99.0"
	}
}
