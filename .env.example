# -----------------------------------------------------------------------------
# Edaya monorepo — ops & seeding (copy to `.env` at repo root, gitignored)
#
# API runtime: apps/api/.env
# Worker secrets: apps/api/.dev.vars
# -----------------------------------------------------------------------------

# Narrative "today" for rolling dashboard seed data (attendance, events, fee due dates).
# Defaults to SEED_REFERENCE_DATE in @edaya/fixtures (2026-06-16).
# SEED_REFERENCE_DATE=2026-06-16

# Local seeding (`bun repo seed`, `bun repo seed --scope doctor`, …)
# SEED_API_URL=http://localhost:9999
# SEED_AUTH_URL=http://localhost:9900
# SEED_APP_ORIGIN=http://localhost:5173

# Staging seeding (`bun repo seed --staging`)
# SEED_STAGING_API_URL=https://staging.school.api.edayaplus.com
# SEED_STAGING_AUTH_URL=https://staging.identity.api.edayaplus.com
# SEED_STAGING_APP_ORIGIN=https://staging.app.edayaplus.com

# Optional fixture overrides: SEED_DATASET, SEED_SCHOOL_ID

# Remote DB (migrations, `bun repo seed clean --staging`) — never commit
# STAGING_DATABASE_URL=

# Staging smoke (`bun repo smoke-test staging`)
# SMOKE_STAFF_EMAIL=
# SMOKE_STAFF_PASSWORD=
