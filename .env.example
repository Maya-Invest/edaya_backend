# -----------------------------------------------------------------------------
# EDaya monorepo — ops & seeding (copy to `.env` at repo root, gitignored)
#
# API runtime: apps/api/.env
# Worker secrets: apps/api/.dev.vars
# -----------------------------------------------------------------------------

# Narrative "today" for rolling dashboard seed data (attendance, events, fee due dates).
# Defaults to the collège clock in @edaya/fixtures (2026-09-17).
# SEED_REFERENCE_DATE=2026-09-17

# Local seeding (`bun repo ops seed`, `bun repo ops seed --scope doctor`, …)
# SEED_API_URL=http://localhost:9999
# SEED_APP_ORIGIN=http://localhost:5173

# Staging seeding (`bun repo ops seed staging`)
# SEED_STAGING_API_URL=https://staging.api.edayaplus.com
# SEED_STAGING_APP_ORIGIN=https://staging.app.edayaplus.com

# Optional fixture override: SEED_SCHOOL_ID

# Remote DB (migrations, `bun repo ops seed clean staging`) — never commit
# STAGING_DATABASE_URL=

# Staging smoke (`bun repo ops smoke api staging`)
# SMOKE_STAFF_EMAIL=
# SMOKE_STAFF_PASSWORD=
